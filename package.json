{
  "name": "gherkin-behat-linker",
  "displayName": "Gherkin ↔ Behat Linker",
  "description": "Bidirectional navigation between Gherkin .feature steps and Behat PHP step definitions — static analysis, zero PHP, exact Behat matching semantics",
  "version": "0.1.0",
  "publisher": "ailonn",
  "packageManager": "pnpm@10.33.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ailonn/vscode-behat-gherkin-linker.git"
  },
  "bugs": {
    "url": "https://github.com/ailonn/vscode-behat-gherkin-linker/issues"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20 <23"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension/activation.js",
  "contributes": {
    "configuration": {
      "title": "Gherkin Behat Linker",
      "properties": {
        "gherkinBehat.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Index the workspace (navigation + diagnostics). Set to false to turn the extension off — no file is read, no diagnostic is emitted."
        },
        "gherkinBehat.features": {
          "type": [
            "string",
            "array"
          ],
          "default": "**/*.feature",
          "items": {
            "type": "string"
          },
          "description": "Glob(s) of Gherkin feature files to index. vendor/ and node_modules/ are always excluded. v0: only the first workspace root is indexed."
        },
        "gherkinBehat.steps": {
          "type": [
            "string",
            "array"
          ],
          "default": "**/*.php",
          "items": {
            "type": "string"
          },
          "description": "Glob(s) of PHP step definition files to index. vendor/ and node_modules/ are always excluded. v0: only the first workspace root is indexed."
        },
        "gherkinBehat.orphans": {
          "type": "boolean",
          "default": true,
          "description": "Emit info diagnostics for orphan step definitions (no matching step)."
        }
      }
    }
  },
  "vscode:prepublish": "pnpm run build",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck:all": "tsc -p tsconfig.test.json",
    "test": "vitest run test/unit test/stress",
    "test:watch": "vitest test/unit",
    "test:integration": "pnpm run build && node test/integration/runner.mjs"
  },
  "dependencies": {
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "4.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
